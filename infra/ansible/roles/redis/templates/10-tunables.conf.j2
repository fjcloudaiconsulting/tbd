{# Live-tunable settings: changes here are applied to the running server #}
{# via `redis-cli CONFIG SET` (see the "Apply redis live tunables" handler). #}
{# No restart, no dropped client connections, no spurious "Redis: DOWN" on #}
{# the admin dashboard. #}
{# #}
{# ⚠ THIS FILE is what persists the values across a restart, because #}
{# redis.conf includes it. The handler deliberately does NOT run #}
{# CONFIG REWRITE: it wrote the running config back into redis.conf AFTER #}
{# the include line, where it shadowed this file and pinned an old password #}
{# through a rotation. That was TBD-412, a production login outage. See #}
{# roles/redis/handlers/main.yml. #}
maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}

{# Persistence — AOF is on because Redis is the auth-session store. #}
{# A Redis restart without persistence drops every active session. #}
{# appendfsync=everysec gives at most 1s of session-write loss on a #}
{# hard crash; normal restart replays AOF and sessions survive. #}
appendonly {{ redis_appendonly }}
appendfsync {{ redis_appendfsync }}

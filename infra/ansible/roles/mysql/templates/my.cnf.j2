{# Custom overrides loaded from /etc/mysql/mysql.conf.d/. The Ubuntu MySQL #}
{# package's main config includes this directory by default. #}
{# bind-address = 0.0.0.0 because MySQL 8 only honours one bind-address; #}
{# the DO Cloud Firewall (pfv-data-fw) enforces VPC-only access. #}
{# TBD-360: `default-authentication-plugin` was REMOVED in MySQL 8.4, and an #}
{# unknown variable in an option file is FATAL - mysqld aborts, it does not #}
{# warn. Measured with `mysqld --validate-config` against the real binaries: #}
{#                                                                          #}
{#                    | 8.0    | 8.4                                        #}
{#   with this line   | exit 0 | exit 1, "unknown variable                   #}
{#                    |        |  'default-authentication-plugin=...'"       #}
{#   without it       | exit 0 | exit 0                                      #}
{#                                                                          #}
{# Removing it is therefore rollback-safe, which matters because this        #}
{# template is re-rendered with `notify: Restart mysql` on every run against #}
{# the CURRENT 8.0 box - the fix has to be applied BEFORE the upgrade, on a  #}
{# server that still has to start. Do not re-add it, and do not swap in      #}
{# `authentication_policy` without re-running validate-config on both.       #}
{#                                                                          #}
{# Dropping it also moves the server default for NEWLY created accounts from #}
{# mysql_native_password to caching_sha2_password, which is the direction    #}
{# this ticket wants. Every account in tasks/main.yml names its plugin       #}
{# explicitly, so none of them depended on this default.                     #}
[mysqld]
bind-address = 0.0.0.0

# DNS lookups on every TCP connect are pure overhead at our scale; auth is
# host=% for pfv_app, no hostname-based ACLs to break.
skip-name-resolve

# --- Connections ---
max_connections = {{ mysql_max_connections }}
# 0 = let MySQL auto-tune. Hard-capping concurrency on a 1-vCPU box just
# leaves cores idle when one query is blocked on I/O.
innodb_thread_concurrency = 0

# --- Buffer pool / memory ---
innodb_buffer_pool_size = {{ mysql_innodb_buffer_pool_size }}
innodb_buffer_pool_instances = {{ mysql_innodb_buffer_pool_instances }}
{# TBD-360: innodb_log_file_size is DEPRECATED on 8.4 - it boots, but warns #}
{# "Deprecated configuration parameters innodb_log_file_size and/or #}
{# innodb_log_files_in_group have been used to compute #}
{# innodb_redo_log_capacity". Measured: the modern parameter is valid on #}
{# BOTH 8.0 and 8.4 (validate-config exit 0 on each), 256M yields exactly #}
{# the 268435456 the old pair computed, and the warning disappears. #}
innodb_redo_log_capacity = {{ mysql_innodb_redo_log_capacity }}
innodb_log_buffer_size = {{ mysql_innodb_log_buffer_size }}
tmp_table_size = {{ mysql_tmp_table_size }}
max_heap_table_size = {{ mysql_max_heap_table_size }}

# --- I/O (DO SSD) ---
# O_DIRECT skips the OS page cache so we don't double-buffer dirty pages
# (InnoDB's buffer pool already caches them). Standard for InnoDB on Linux.
innodb_flush_method = O_DIRECT
# Flush-neighbors is an HDD optimization (coalesces adjacent dirty pages
# into one seek). On SSD it's a small write-amp tax for no payoff.
innodb_flush_neighbors = 0
innodb_io_capacity = {{ mysql_innodb_io_capacity }}

# --- 8.4 default drift (TBD-360) ---
# MEASURED, not assumed: booting the same datadir under 8.0.46 and 8.4.11 and
# diffing SHOW GLOBAL VARIABLES, exactly 10 InnoDB/memory/thread knobs change.
# Most of them REDUCE memory on this 2GB box co-hosting Redis, so they are
# deliberately allowed through rather than pinned:
#
#   innodb_adaptive_hash_index      ON  -> OFF   frees buffer-pool memory
#   innodb_change_buffering         all -> none  frees memory
#   innodb_purge_threads            4   -> 1     fewer threads; fine on 1 vCPU
#   innodb_read_io_threads          4   -> 5     negligible
#   innodb_use_fdatasync            OFF -> ON    cheaper fsync
#   temptable_use_mmap              ON  -> OFF   \ 8.4 sends large temp tables
#   temptable_max_mmap              1G  -> 0     / to InnoDB rather than mmap
#   innodb_buffer_pool_in_core_file ON  -> OFF   core-dump size only
#
# temptable_use_mmap IS settable and rollback-safe, but it is DEPRECATED in 8.4
# and pinning it would re-enable behaviour 8.4 deliberately turned off, so it is
# left alone.
#
# The one change that INCREASES resource use is doublewrite_pages, 4 -> 128
# (32x the doublewrite buffer). Pinned to the 8.0 value so the upgrade changes
# one thing at a time; revisit once 8.4 has run in production for a while.
#
# NOTE the io_capacity pins above are what neutralise the spec's headline
# concern: 8.4 re-defaults innodb_io_capacity 200 -> 10000, which would be
# hostile here. Measured on 8.4 WITH this file: still 1000/2000.
innodb_doublewrite_pages = {{ mysql_innodb_doublewrite_pages }}
innodb_io_capacity_max = {{ mysql_innodb_io_capacity_max }}

# --- Durability ---
# innodb_flush_log_at_trx_commit = 1 is the MySQL default and is the right
# call for a finance app: every committed txn is fsynced to redo log on
# commit. Setting 2 trades durability for ~10-20% write throughput; not
# worth it here. innodb_doublewrite stays on (default) as torn-write
# protection.

character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# Slow query log helps catch regressions early on a small box.
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

{# Custom overrides loaded from /etc/mysql/mysql.conf.d/. The Ubuntu MySQL #}
{# package's main config includes this directory by default. #}
{# bind-address = 0.0.0.0 because MySQL 8 only honours one bind-address; #}
{# the DO Cloud Firewall (pfv-data-fw) enforces VPC-only access. #}
{# TBD-360: `default-authentication-plugin` was REMOVED in MySQL 8.4, and an #}
{# unknown variable in an option file is FATAL - mysqld aborts, it does not #}
{# warn. Measured with `mysqld --validate-config` against the real binaries: #}
{#                                                                          #}
{#                    | 8.0    | 8.4                                        #}
{#   with this line   | exit 0 | exit 1, "unknown variable                   #}
{#                    |        |  'default-authentication-plugin=...'"       #}
{#   without it       | exit 0 | exit 0                                      #}
{#                                                                          #}
{# Removing it is therefore rollback-safe, which matters because this        #}
{# template is re-rendered with `notify: Restart mysql` on every run against #}
{# the CURRENT 8.0 box - the fix has to be applied BEFORE the upgrade, on a  #}
{# server that still has to start. Do not re-add it, and do not swap in      #}
{# `authentication_policy` without re-running validate-config on both.       #}
{#                                                                          #}
{# Dropping it also moves the server default for NEWLY created accounts from #}
{# mysql_native_password to caching_sha2_password, which is the direction    #}
{# this ticket wants. Every account in tasks/main.yml names its plugin       #}
{# explicitly, so none of them depended on this default.                     #}
[mysqld]
bind-address = 0.0.0.0

# DNS lookups on every TCP connect are pure overhead at our scale; auth is
# host=% for pfv_app, no hostname-based ACLs to break.
skip-name-resolve

# --- Connections ---
max_connections = {{ mysql_max_connections }}
# 0 = let MySQL auto-tune. Hard-capping concurrency on a 1-vCPU box just
# leaves cores idle when one query is blocked on I/O.
innodb_thread_concurrency = 0

# --- Metadata-lock waits (TBD-416) ---
# The default is 31536000 (365 days), which is a hang wearing a timeout's name.
# A blocked DDL statement does not fail: it waits, AND its PENDING exclusive MDL
# outranks every new shared request on the same table, so the whole application
# queues behind it. It does not self-heal -- killing the client does not release
# a server thread parked in an MDL wait; only KILL does. The standing exposure is
# not the schema rename (one attended statement, which sets its own lower bound);
# it is the alembic PRE_DEPLOY job, which issues ALTER TABLE against this server
# whenever a revision is pending, with no bound of its own. (The job runs on
# every deploy; it only emits DDL when there is something to apply.)
#
# ⚠ That job is therefore also an ACTOR under this bound, not just a victim. The
# residual: MySQL DDL auto-commits per statement and some revisions carry many
# operations (045_reconciliation_state.py has 13), so a 1205 partway leaves a
# revision half-applied with alembic_version unstamped, and the retry dies on
# "Duplicate column name" until cleared by hand. Accepted deliberately: the
# alternative is an ALTER that waits up to a year while queueing the whole app
# behind its pending exclusive MDL. migrate.py already bounds this to a single
# revision by driving alembic one revision at a time.
#
# 30s is far above any legitimate wait on a 6.7 MB / 50-table dataset, so a
# nonzero wait here always means something is genuinely stuck. It is deliberately
# not lower: this value is also the VICTIM's timeout -- what an ordinary app
# query waits while queued behind a pending exclusive MDL -- so a tight global
# turns a legitimate migration into user-visible errors.
#
# ⚠ This is NOT innodb_lock_wait_timeout, which bounds ROW-lock waits and stays
# at its default of 50. Different lock class, different lever; do not conflate.
#
# ⚠ Valid on both 8.0 and 8.4 (present since 5.5), so this does not repeat the
# `default-authentication-plugin` unknown-variable trap documented above.
lock_wait_timeout = {{ mysql_lock_wait_timeout }}

# --- Buffer pool / memory ---
innodb_buffer_pool_size = {{ mysql_innodb_buffer_pool_size }}
innodb_buffer_pool_instances = {{ mysql_innodb_buffer_pool_instances }}
{# TBD-360: innodb_log_file_size is DEPRECATED on 8.4 - it boots, but warns #}
{# "Deprecated configuration parameters innodb_log_file_size and/or #}
{# innodb_log_files_in_group have been used to compute #}
{# innodb_redo_log_capacity". Measured: the modern parameter is valid on #}
{# BOTH 8.0 and 8.4 (validate-config exit 0 on each), 256M yields exactly #}
{# the 268435456 the old pair computed, and the warning disappears. #}
innodb_redo_log_capacity = {{ mysql_innodb_redo_log_capacity }}
innodb_log_buffer_size = {{ mysql_innodb_log_buffer_size }}
tmp_table_size = {{ mysql_tmp_table_size }}
max_heap_table_size = {{ mysql_max_heap_table_size }}

# --- I/O (DO SSD) ---
# O_DIRECT skips the OS page cache so we don't double-buffer dirty pages
# (InnoDB's buffer pool already caches them). Standard for InnoDB on Linux.
innodb_flush_method = O_DIRECT
# Flush-neighbors is an HDD optimization (coalesces adjacent dirty pages
# into one seek). On SSD it's a small write-amp tax for no payoff.
innodb_flush_neighbors = 0
innodb_io_capacity = {{ mysql_innodb_io_capacity }}

# --- 8.4 default drift (TBD-360) ---
# Booting the SAME datadir under 8.0.46 and 8.4.11 and diffing SHOW GLOBAL
# VARIABLES:
#
#   25 value changes on names present in both
#   15 variables REMOVED in 8.4 -- including `default_authentication_plugin`,
#      the one this whole ticket exists for. A value-diff structurally CANNOT
#      see a removal, so a "what changed" diff is not a safety check on its own.
#    7 variables NEW in 8.4
#
# ⚠ Measured in a container on a multi-core dev host, NOT on the 1-vCPU
# droplet, and several 8.4 defaults are CPU-derived. `innodb_read_io_threads`
# reading 5 requires 10 logical processors; on 1 vCPU it stays 4.
# `innodb_purge_threads`, `innodb_parallel_read_threads` and the auto-sized
# buffer-pool instances are the same class.
#
# ⚠⚠ This could NOT be corrected by constraining the container. Neither
# `--cpus=1` (a CFS quota) nor `--cpuset-cpus=0` changes what mysqld sees under
# Docker Desktop, which runs a Linux VM whose processor count mysqld reads.
# So the CPU-derived values below are UNMEASURED for the target. Treat the
# subset as indicative of DIRECTION only, and read the real values on the box:
#
#   SELECT @@innodb_read_io_threads, @@innodb_purge_threads,
#          @@innodb_buffer_pool_instances, @@innodb_parallel_read_threads;
#
# Nothing in that subset is pinned. The memory-relevant ones mostly move in a
# direction that is fine or favourable here, and the honest reasons are not
# always the obvious ones:
#
#   innodb_adaptive_hash_index  ON  -> OFF   8.4 disabled it for LATCH
#                                            CONTENTION, not to save memory
#   innodb_change_buffering     all -> none  frees no RSS (the buffer pool is a
#                                            fixed allocation); the real effect
#                                            is more read IOPS on secondary
#                                            index maintenance
#   innodb_purge_threads        4   -> 1     fewer threads; fine on 1 vCPU
#   innodb_use_fdatasync        OFF -> ON    cheaper fsync
#   temptable_use_mmap/max_mmap ON/1G -> OFF/0  removes an overflow tier
#   innodb_doublewrite_pages    4   -> 128   DELIBERATELY NOT PINNED: 128 is a
#                                            vendor performance fix (4 causes
#                                            excessive fsyncs; 128 measured
#                                            elsewhere at ~55% fewer write
#                                            IOPS), which is the right
#                                            direction on an IOPS-limited
#                                            droplet. Costs disk, not RAM.
#
# ⚠ The real unaddressed memory exposure is `temptable_max_ram`, which does NOT
# appear in the diff because it is 1 GB on both sides (8.4's 3%-of-RAM rule
# floors at 1 GB, and 3% of 2 GB is below that). It is unpinned, and it is a
# ceiling larger than what remains after buffer pool 768M + Redis 300M on a 2 GB
# box. Consider pinning it before the window.
#
# The io_capacity pins above are what neutralise the spec's headline concern:
# 8.4 re-defaults innodb_io_capacity 200 -> 10000, hostile here. Measured under
# 8.4 WITH this file: still 1000/2000.
innodb_io_capacity_max = {{ mysql_innodb_io_capacity_max }}

# --- Durability ---
# innodb_flush_log_at_trx_commit = 1 is the MySQL default and is the right
# call for a finance app: every committed txn is fsynced to redo log on
# commit. Setting 2 trades durability for ~10-20% write throughput; not
# worth it here. innodb_doublewrite stays on (default) as torn-write
# protection.

character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# Slow query log helps catch regressions early on a small box.
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

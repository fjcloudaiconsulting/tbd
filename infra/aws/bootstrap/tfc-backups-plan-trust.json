{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TFCWorkloadIdentityPlanOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::884686184019:oidc-provider/app.terraform.io"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "app.terraform.io:aud": "aws.workload.identity"
        },
        "StringLike": {
          "app.terraform.io:sub": "organization:FlamaCorp:project:*:workspace:tbd-backups:run_phase:plan"
        }
      }
    }
  ]
}

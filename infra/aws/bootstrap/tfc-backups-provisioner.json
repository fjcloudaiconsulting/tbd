{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTheBackupBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::tbd-mysql-backups-884686184019",
        "arn:aws:s3:::tbd-mysql-backups-884686184019/*"
      ]
    },
    {
      "Sid": "ManageTheBackupKey",
      "Effect": "Allow",
      "Action": "kms:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/component": "mysql-offhost-backup"
        }
      }
    },
    {
      "Sid": "CreateTheBackupKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:ListAliases",
        "kms:TagResource",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageOnlyTheBackupIdentities",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": [
        "arn:aws:iam::884686184019:user/pfv-backup-uploader",
        "arn:aws:iam::884686184019:role/github-actions-backup-probe",
        "arn:aws:iam::884686184019:role/tfc-backups-provisioner",
        "arn:aws:iam::884686184019:role/tfc-backups-plan",
        "arn:aws:iam::884686184019:oidc-provider/app.terraform.io",
        "arn:aws:iam::884686184019:oidc-provider/token.actions.githubusercontent.com"
      ]
    },
    {
      "Sid": "ReadOwnIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "iam:ListOpenIDConnectProviders"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverReadBackupContent",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "kms:Decrypt",
        "kms:ReEncryptFrom"
      ],
      "Resource": "*"
    }
  ]
}

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# Node / Frontend
# Trailing slash matches DIRECTORIES ONLY. A symlink named node_modules slipped
# past that rule and was committed in 9ed5f63d -- a self-referential link
# (frontend/node_modules -> /abs/path/frontend/node_modules) that every clone
# inherited, that resolves to ELOOP, and that made HCP Terraform configuration
# uploads fail outright. No trailing slash: match files and symlinks too.
node_modules
.next/
.next-apex/
out/
out-apex/
.next.config.ts.bak
.apex-staged-routes/
frontend/next-env.d.ts

# Environments
.env
.env.local
.env.*.local
.venv
.venv*/
venv/

# Docker
mysql_data/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Local dev
*.sqlite
*.db
*.log

# Claude stuff
.claude/
.superpowers/
.playwright-mcp/
.cursor/
.mcp.json
# Superpowers planning artifacts are local-only. The rest of docs/ is tracked:
# product, design and operations documentation live there. The leading slash
# anchors both rules to the repo root, so frontend/app/docs/ is unaffected.
/docs/superpowers/

# Project-scoped agent instructions, deliberately out of version control
# (the public repo carries no agent context). Content lives in
# ~/.claude/projects/-Users-flamarion-src-tbd/CLAUDE.md
CLAUDE.local.md

# Local test fixtures and scratch
mock/
*.png
!frontend/public/**/*.png
frontend/tsconfig.tsbuildinfo

# Codex
AGENTS.md
docker-compose.loan-test.yml

# TBD-393: transient act() warning tally, written by the vitest reporter and
# consumed by tests/act-guard/judge.mjs in the same run. Never committed --
# the committed artifact is tests/act-guard/act-baseline.json.
frontend/.act-warnings.json
frontend/tests/act-guard/.run*.json
